# The llama.cpp this repository builds. Sourced by scripts/build.sh
# (KEY=VALUE, no spaces). Mirrors wipemark-app's
# crates/wipemark-llama-sys/PIN.md.
LLAMA_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_TAG=b10731
LLAMA_COMMIT=0eadefebd3f8f92a86d634a0e5b8fffc9dc792c0
LLAMA_VERSION=0.3.0
GGML_COMMIT=36da57138425487184aa1da2eee2cde155909c6f
GGML_VERSION=0.22.0
# The canonical pin string wipemark-llama-sys quotes (`pin::PIN`).
PIN_STRING=ggml-0.22.0+llama-0eadefe
# The release of this pin, which is also its tag and its archives' name:
# LLAMA_TAG for the first build, LLAMA_TAG-N when the same llama.cpp is
# built again with other flags. Nothing else names the tag.
#   b10731   (2026-10-04) the first build.
#   b10731-2 (2026-11-16) Windows with the static C runtime (/MT) and
#            without OpenMP, so its DLLs import no Visual C++ runtime DLL,
#            and with patches/windows/ applied (llama.dll opens its own
#            files; a FILE* may not cross from one static runtime to
#            another).
RELEASE_TAG=b10731-2
